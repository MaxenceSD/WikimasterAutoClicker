{
  "manifest_version": 3,
  "name": "WkMstr Helper",
  "version": "1.0.0",
  "description": "Helper pour le site Wiki-Masters",
  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "icons": {
    "16": "icons/logo.png",
    "48": "icons/logo.png",
    "128": "icons/logo.png"
  },
  "action": {
    "default_title": "Clic automatique",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.wiki-masters.com/*",
        "https://wiki-masters.com/*"
      ],
      "css": [
        "finder/finder.css",
        "quick-market/content.css",
        "quick-market/modal.css"
      ],
      "js": [
        "opener/content.js",
        "finder/core.js",
        "finder/panel.js",
        "finder/finder.js",
        "buyer/content.js",
        "quick-market/storage.js",
        "quick-market/api.js",
        "quick-market/modal.js",
        "quick-market/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}